{
  "name": "@local/dsh-voice-duplex",
  "version": "1.1.0",
  "private": true,
  "description": "Local Breeze TTS 2 + SenseVoice voice call plugin for DSH, with model/hardware installer, bundled voices, and a local clock.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "docs"
  ],
  "dependencies": {
    "sherpa-onnx-node": "2.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/speech-text.cjs && node --test test/clock.test.mjs test/models.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "license": "MIT"
}
